# Local development examples only. Do not put real credentials in Git.
# Export these variables in the shell before starting the app.
WORKER_BACKEND=mock
VIDEOGEN_DATA_DIR=.local/videogen
VIDEOGEN_API_PORT=8001
VIDEOGEN_WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
VIDEOGEN_WEB_ORIGIN=http://127.0.0.1:3000

# Offline authored practice works without a model or credentials.
VIDEOGEN_COACH_PROVIDER=offline_practice

# Optional: use an already installed/running local model. The app never downloads one.
# VIDEOGEN_COACH_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=YOUR_EXISTING_LOCAL_MODEL

# Real media inference remains unimplemented and requires separate hardware/rights checks.
# COMFYUI_BASE_URL=http://127.0.0.1:8188
